# ---------------------------------------------------------------------------
# Environment template.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored (see .gitignore: `.env*` except this file). Never
# commit real values. Every value below is a PLACEHOLDER with no key shape: replace
# the `replace-with-...` markers with values from YOUR OWN local or throwaway
# Supabase project. Nothing here points at a real service.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. Required by the app and by `next build`
#    (validated in src/lib/env.ts: URL must be a valid URL, the rest non-empty,
#    INGEST_SECRET at least 16 characters)
# ===========================================================================

# Supabase API URL. The value below is the default of a local `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public (anon) key. `supabase status` prints it for a local stack. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-local-anon-key

# Service-role key. SERVER ONLY, bypasses RLS: never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-local-service-role-key

# Shared secret for the ingestion endpoints (`x-ingest-secret` header of
# /api/refresh and /api/refresh/archivo). Minimum 16 characters.
# HIGH-PRIVILEGE CREDENTIAL: whoever holds it can overwrite the catalog and feed
# bytes to the spreadsheet parser. Treat it like the service-role key. See
# docs/security.md and docs/known-limitations.md (ING-1).
INGEST_SECRET=replace-with-a-random-secret-of-16-or-more-characters

# ===========================================================================
# 2. Optional: public site URL (required in production deployments)
# ===========================================================================

# Public origin of the portal, absolute URL WITH protocol. It feeds the Origin
# allowlist of the write routes (src/lib/api/origin.ts). Locally
# http://localhost:3000 is allowed anyway. Without any public-domain source in a
# production deployment, every POST/PUT/PATCH/DELETE answers 403 forbidden_origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================================================
# 3. Optional: weekly digest endpoint (n8n example workflow)
#    See n8n/README.md. Left unset, only that endpoint answers `config_error`.
# ===========================================================================

# Dedicated secret for /api/avisos/envios (`x-avisos-secret` header). Minimum 16
# characters. HIGH-PRIVILEGE: it can read every user's notices.
# AVISOS_SECRET=replace-with-another-random-secret-of-16-or-more-characters

# ===========================================================================
# 4. Optional: grounded assistant (chat) and corpus embeddings
#    Left unset, only the chat answers `config_error`.
# ===========================================================================

# Provider selection: `openai` or `deepseek`. If unset, DeepSeek is used when its
# key exists, otherwise OpenAI.
# CHAT_PROVEEDOR=openai

# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODELO=replace-with-model-id          # default lives in src/lib/chat/proveedor.ts
# OPENAI_MODELO_EMBEDDING=text-embedding-3-small  # 1536 dims, tied to vector(1536) in migration 0030
# DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# DEEPSEEK_MODELO=replace-with-model-id

# ===========================================================================
# 5. Optional: scripts and tooling (NOT read by the app)
# ===========================================================================

# Postgres connection string for scripts/aplicar-migracion.mjs,
# scripts/compilar-migracion.mjs and scripts/guarda-lista-blanca.mjs.
# SUPABASE_DB_URL is accepted as an alternative name. Use a local or throwaway
# database only: these scripts write to it. A local `supabase start` stack listens on 54322.
# DATABASE_URL=postgresql://postgres:replace-with-local-db-password@127.0.0.1:54322/postgres

# Admin account used by `npm run layout-check` to open a session through the SDK
# (it never creates accounts). Read from the PROCESS environment, never from this file.
# PARCHE_ADMIN_EMAIL=admin@example.com
# PARCHE_ADMIN_PASSWORD=replace-with-admin-password
# LAYOUT_CHECK_PORT=3210

# Open the /control-layout and /control-estados screens used by the layout gate.
# LAYOUT_CHECK=1

# Maintenance mode: `1` answers 503 JSON on the API and shows /mantenimiento
# (admins are exempt). See src/middleware.ts.
# MANTENIMIENTO=0

# Isolate the Next.js build output when several builds run at once (default `.next`).
# NEXT_DIST_DIR=.next

# Write the visual-evidence HTML pages from the component tests into `.evidencia/`
# (git-ignored). Without it those tests only check the generator.
# EVIDENCIA_VISUAL=1
