# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output (one folder per NEXT_DIST_DIR value)
/.next/
/.next-*/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# pdf.js worker: copied from node_modules/pdfjs-dist by scripts/copiar-pdf-worker.mjs
# on every install (postinstall). It is a derived artifact; committing it would let the
# two copies drift apart.
/public/pdf.worker.min.mjs

# Test runs: vitest writes one JSON report per run here (see vitest.config.ts)
/coverage
/.vitest/
/test-results/
/playwright-report/

# Environment: only the template is versioned. Real values never enter the repo.
.env*
!.env.example

# Misc
*.log
*.pem
.DS_Store
.vercel

# Generated by the visual-evidence tests (EVIDENCIA_VISUAL=1); never versioned
/.evidencia/

# Sample workbooks written by scripts/generar-datos-muestra.mjs (fixed seed, synthetic data)
/muestra/

# Local corpus folder for scripts/corpus-sync.mjs (default root); real notes must never be committed
/corpus-ejemplo/
